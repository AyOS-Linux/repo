# Maintainer: AyOS Linux <твой_email@example.com>
pkgname=ayder
pkgver=3.4.3
pkgrel=1
pkgdesc="Ayder — AyOS custom Calamares installer (built from source)"
arch=('x86_64')
url="https://github.com/AyOS-Linux/ayder"
license=('GPL-3.0-or-later')

provides=('calamares')
conflicts=('calamares')

depends=(
    'kcoreaddons'
    'kpmcore'
    'libpwquality'
    'qt6-declarative'
    'qt6-svg'
    'yaml-cpp'
    'python'
    'python-yaml'
    'python-jsonschema'
    'boost-libs'
    'polkit-qt6'
)

makedepends=(
    'cmake'
    'extra-cmake-modules'
    'ninja'
    'qt6-tools'
    'git'
)

# Тянем код напрямую из твоего репозитория с исходниками
source=("git+https://github.com/AyOS-Linux/ayder.git")
sha256sums=('SKIP')

build() {
    # Заходим в папку, куда makepkg склонировал исходники
    cd "$srcdir/ayder"
    
    # Конфигурируем сборку
    cmake -B build -S . \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWITH_QT6=ON \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache
        
    # Собираем
    cmake --build build
}

package() {
    cd "$srcdir/ayder"
    # Устанавливаем
    DESTDIR="$pkgdir" cmake --install build
    
    # Если твои конфиги лежат в репозитории с исходниками (в папке calamares),
    # но cmake их не подхватывает, раскомментируй и поправь путь ниже:
    # install -d "$pkgdir/etc/calamares"
    # cp -r "$srcdir/ayder/calamares/"* "$pkgdir/etc/calamares/"
}
