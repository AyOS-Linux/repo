# Maintainer: AyOS Linux <твой_email@example.com>
pkgname=ayder
pkgver=3.4.3
pkgrel=1
pkgdesc="Ayder — AyOS custom Calamares installer (built from source)"
arch=('x86_64')
url="https://github.com/AyOS-Linux/ayder"
license=('GPL-3.0-or-later')

# Пакет будет заменять стандартный calamares
provides=('calamares')
conflicts=('calamares')

# Зависимости для работы (основано на требованиях Calamares и твоем README)
depends=(
    'kcoreaddons'
    'kpmcore'
    'libpwquality'
    'qt6-declarative'
    'qt6-svg'
    'yaml-cpp'
    'python'
    'python-yaml'
    'python-jsonschema'
    'boost-libs'
    'polkit-qt6'
)

# Зависимости для сборки
makedepends=(
    'cmake'
    'extra-cmake-modules'
    'ninja'
    'qt6-tools'
    'git'
)

# Исходники: твой форк Calamares и локальная папка с конфигами
source=(
    "ayder::git+https://github.com/AyOS-Linux/ayder.git#branch=main"
    "calamares/"
)
sha256sums=('SKIP' 'SKIP')

build() {
    # Собираем Calamares из исходников
    cmake -B build -S "$srcdir/ayder" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWITH_QT6=ON \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache
    cmake --build build
}

package() {
    # Устанавливаем собранный Calamares
    DESTDIR="$pkgdir" cmake --install build

    # Копируем твои кастомные конфиги и брендинг
    # Из папки calamares/ в системную директорию /etc/calamares/
    install -d "$pkgdir/etc/calamares"
    cp -r "$srcdir/calamares/"* "$pkgdir/etc/calamares/"
}
