# Maintainer: AyOS Linux <твой_email@example.com>
pkgname=ayder
pkgver=3.4.3
pkgrel=1
pkgdesc="Ayder — AyOS custom Calamares installer (built from source)"
arch=('x86_64')
url="https://github.com/AyOS-Linux/ayder"
license=('GPL-3.0-or-later')

provides=('calamares')
conflicts=('calamares')

depends=(
    'kcoreaddons'
    'kpmcore'
    'libpwquality'
    'qt6-declarative'
    'qt6-svg'
    'yaml-cpp'
    'python'
    'python-yaml'
    'python-jsonschema'
    'boost-libs'
    'polkit-qt6'
)

makedepends=(
    'cmake'
    'extra-cmake-modules'
    'ninja'
    'qt6-tools'
    'git'
)


source=(
    "calamares::git+https://github.com/calamares/calamares.git"
    "ayder-configs::git+https://github.com/AyOS-Linux/ayder.git"
)
sha256sums=('SKIP' 'SKIP')

build() {
    # Заходим в папку с исходниками Calamares
    cd "$srcdir/calamares"
    
    # Конфигурируем и собираем
    cmake -B build -S . \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWITH_QT6=ON \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache
        
    cmake --build build
}

package() {
    # Устанавливаем собранный Calamares
    cd "$srcdir/calamares"
    DESTDIR="$pkgdir" cmake --install build

    # Копируем твои конфиги и брендинг из репозитория ayder
    # Предполагается, что папка с конфигами внутри репозитория называется "calamares"
    install -d "$pkgdir/etc/calamares"
    cp -r "$srcdir/ayder-configs/calamares/"* "$pkgdir/etc/calamares/"
}
