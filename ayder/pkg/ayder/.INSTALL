post_install() {
    echo ""
    echo "=============================================================="
    echo "  ⚠  Ayder (custom Calamares) is currently UNDER DEVELOPMENT."
    echo "     This is a placeholder package."
    echo "     No installer functionality is available yet."
    echo ""
    echo "  ⚠  Ayder (кастомный Calamares) находится В РАЗРАБОТКЕ."
    echo "     Это пакет-заглушка."
    echo "     Функциональность установщика пока отсутствует."
    echo ""
    echo "  ℹ  When ready, Ayder will replace the standard Calamares"
    echo "     with its own theme, animations and colors."
    echo "  ℹ  Когда пакет будет готов, Ayder заменит стандартный"
    echo "     Calamares своей темой, анимациями и цветами."
    echo "=============================================================="
    echo ""
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo ""
    echo "Removing Ayder placeholder package..."
    echo "Удаление пакета-заглушки Ayder..."
    echo ""
}
